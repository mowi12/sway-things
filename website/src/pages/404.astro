import AppIcon from '../components/AppIcon.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Sway Things" description="This page doesn't exist on sway-things.org.">
  <main>
    <AppIcon size={72} id="lost" />
    <h1>This page doesn't exist.</h1>
    <p>The link may be old, or mistyped.</p>
    <p><a href="/">Go to the start page</a></p>
  </main>
</Base>

<style>
main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 64px var(--gutter);
  text-align: center;
}

h1 {
  margin-top: 20px;
  font-size: clamp(2rem, 5vw, 3.4rem);
  letter-spacing: -0.03em;
}

p {
  margin: 0;
  color: var(--ink-muted);
}

a {
  font-weight: 600;
  color: var(--heading);
}
</style>
