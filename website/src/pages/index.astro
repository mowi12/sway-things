import Header from '../components/Header.astro';
import Screenshot from '../components/Screenshot.astro';
import Wave from '../components/Wave.astro';
import { repo } from '../data/links.mjs';
import releasedPages from '../data/released-pages.json';
import Base from '../layouts/Base.astro';
import { cliExample, featureGroups, installation, principles, requirements } from '../lib/readme.mjs';
import { shortVersion as version } from '../lib/version.mjs';

// The pages the latest release has, from src/data/released-pages.json: updated in the release pull request, like the
// README, and the list scripts/update-website-screenshots.sh takes screenshots of.
const released = releasedPages.map((page) => page.name);

const groups = featureGroups();
const known = groups.flatMap((group) => group.pages);
for (const page of released) {
  if (!known.includes(page)) {
    throw new Error(`released page "${page}" is not in the README's feature list`);
  }
}

const [principleList, install, requirementsHtml] = await Promise.all([principles(), installation(), requirements()]);
const cli = cliExample();
const includeLine = 'include ~/.config/sway/sway-things/*.conf';
---

<Base
  title="Sway Things: settings for sway"
  description="A real settings app for sway that never touches your config: searchable pages, instant changes and a safety net, for sway and SwayFX."
>
  <Header />

  <main>
    <section class="hero" aria-labelledby="title">
      <h1 id="title">Settings for sway. Your config stays yours.</h1>
      <p class="lede">
        A settings app for the sway Wayland compositor and SwayFX: a searchable sidebar of pages, controls that apply
        instantly, and a safety net for risky changes. It never edits a line you wrote.
      </p>
      <p class="actions">
        <a class="button primary" href="#install">Install Sway Things</a>
        <a class="button" href={repo}>Source on GitHub</a>
      </p>
    </section>

    <section class="split" aria-label="Your config and the files of Sway Things">
      <div class="rule" aria-hidden="true"></div>
      <figure class="half yours">
        <figcaption><strong>Yours</strong> ~/.config/sway/config</figcaption>
        <pre><code><span>set $mod Mod4</span><span>bindsym $mod+Return exec foot</span><span>gaps inner 6</span><span class="added">{includeLine}</span></code></pre>
        <p class="note">One line you add yourself. Every other line stays as you wrote it.</p>
      </figure>
      <div class="half ours">
        <p class="caption"><strong>Ours</strong> ~/.config/sway/sway-things/</p>
        <div class="shot">
          <Screenshot
            id="mouse-touchpad"
            alt="The Mouse & Touchpad page of Sway Things: a sidebar of pages, and rows with switches, sliders and the sway directive of each setting."
            sizes="(max-width: 820px) calc(100vw - 2 * var(--gutter)), 560px"
            eager
          />
        </div>
        <p class="note">Settings go to files Sway Things owns, and apply live.</p>
      </div>
    </section>

    <section id="principles" class="block" aria-labelledby="principles-title">
      <h2 id="principles-title">Principles</h2>
      <dl class="principles">
        {principleList.map(({ title, html }) => (
          <div>
            <dt>{title}</dt>
            <dd set:html={html} />
          </div>
        ))}
      </dl>
    </section>

    <section id="pages" class="block" aria-labelledby="pages-title">
      <h2 id="pages-title">Pages</h2>
      <p class="intro">
        The sidebar of the app. The pages marked with a dot are in the latest release; the others are planned. The <a
          href={`${repo}/wiki/Feature-Catalog`}
        >Feature Catalog</a> lists every item.
      </p>
      <div class="sidebar">
        {groups.map(({ title, pages }) => (
          <div class="group">
            <h3>{title}</h3>
            <ul>
              {pages.map((page) => (
                <li class={released.includes(page) ? 'released' : undefined}>
                  <span class="dot" aria-hidden="true"></span>
                  <span>{page}</span>
                  <span class="visually-hidden">
                    {released.includes(page) ? `(released in ${version})` : '(planned)'}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="legend" aria-hidden="true">
        <span class="dot on"></span><span>In the latest release ({version})</span>
        <span class="dot"></span><span>Planned</span>
      </p>
      <div class="gallery">
        {releasedPages.map(({ id, name }) => (
          <figure>
            <div class="shot">
              <Screenshot
                id={id}
                alt={`The ${name} page of Sway Things`}
                sizes="(max-width: 900px) calc(100vw - 2 * var(--gutter)), 580px"
              />
            </div>
            <figcaption>{name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="command-line" class="block cli" aria-labelledby="cli-title">
      <div>
        <h2 id="cli-title">Also on the command line</h2>
        <p class="intro">Everything the app can set is scriptable, from a key binding or your dotfiles.</p>
      </div>
      <pre><code>{cli}</code></pre>
    </section>
  </main>

  <Wave />
  <section id="install" class="install" aria-labelledby="install-title">
    <h2 id="install-title">Install</h2>
    <div class="install-intro" set:html={install.intro} />
    <nav class="methods" aria-label="Installation methods">
      <ul>{install.methods.map(({ id, title }) => <li><a href={`#${id}`}>{title}</a></li>)}</ul>
    </nav>
    {install.methods.map(({ id, title, html }) => (
      <section id={id} class="method" aria-labelledby={`${id}-title`}>
        <h3 id={`${id}-title`}>{title}</h3>
        <Fragment set:html={html} />
      </section>
    ))}
    <p class="more">
      Details, like Fedora Rawhide or building without just, are in the <a href={`${repo}#installation`}>README</a>.
    </p>
    <section class="method" aria-labelledby="requirements-title">
      <h3 id="requirements-title">Requirements</h3>
      <Fragment set:html={requirementsHtml} />
    </section>
    <p class="visually-hidden" id="copy-status" aria-live="polite"></p>
  </section>
</Base>

<script is:inline>
// Copy buttons for the install commands. Without JavaScript or a clipboard there are no buttons, and the commands
// stay selectable as they are.
(() => {
  if (!navigator.clipboard) return;
  const status = document.getElementById('copy-status');
  // Static icon markup: two overlapping sheets, and a check mark for the copied state.
  const svg = (paths) =>
    `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" `
    + `stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
  const copyIcon = svg('<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/>');
  const doneIcon = svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>');
  for (const pre of document.querySelectorAll('.method pre')) {
    const heading = pre.closest('.method')?.querySelector('h3');
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy';
    button.innerHTML = copyIcon;
    button.setAttribute('aria-label', 'Copy commands');
    if (heading?.id) button.setAttribute('aria-describedby', heading.id);
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent.trimEnd() + '\n');
        button.innerHTML = doneIcon;
        button.classList.add('done');
        status.textContent = `Copied the commands for ${heading?.textContent ?? 'this method'}.`;
      } catch {
        status.textContent = 'Copying failed. Select the commands instead.';
      }
      setTimeout(() => {
        button.innerHTML = copyIcon;
        button.classList.remove('done');
      }, 2000);
    });
    const wrapper = document.createElement('div');
    wrapper.className = 'code';
    pre.replaceWith(wrapper);
    wrapper.append(pre, button);
  }
})();
</script>

<style>
/* Hero */
.hero {
  padding: clamp(32px, 7vh, 88px) var(--gutter) 0;
  text-align: center;
}

h1 {
  max-width: 14ch;
  margin: 0 auto;
  font-size: clamp(2.6rem, 7.4vw, 6.2rem);
  font-weight: 700;
  line-height: 0.94;
  letter-spacing: -0.035em;
}

.lede {
  max-width: 50ch;
  margin: 24px auto 30px;
  font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  color: var(--ink-muted);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  margin: 0;
}

.button {
  padding: 15px 24px;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
  color: var(--heading);
  box-shadow: inset 0 0 0 2px currentColor;
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.button.primary {
  background: var(--accent);
  color: var(--on-accent);
  box-shadow: 0 10px 24px -12px rgb(15 111 102 / 0.9);
}

.button:hover {
  transform: translateY(-2px);
}

/* Yours and ours, divided by the split line of the icon */
.split {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 0 calc(2 * var(--gutter));
  padding: clamp(40px, 6vw, 72px) var(--gutter) 0;
}

.rule {
  position: absolute;
  top: clamp(24px, 4vw, 48px);
  bottom: calc(-1 * clamp(60px, 7vw, 110px));
  left: 50%;
  width: 6px;
  border-radius: 3px;
  background: var(--brand-navy);
  transform: translateX(-50%);
}

.half {
  position: relative;
  z-index: 1;
  max-width: 520px;
  margin: 0;
}

.yours {
  justify-self: end;
  width: 100%;
}

.half figcaption,
.half .caption {
  margin: 0 0 12px;
  font: 0.8rem/1.4 var(--font-mono);
  color: var(--ink-muted);
}

.half strong {
  margin-right: 0.6em;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--heading);
}

.ours strong {
  color: var(--accent-ink);
}

.yours pre {
  margin: 0;
  padding: 16px 0;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  line-height: 1.85;
  color: var(--ink-muted);
}

.yours pre span {
  display: block;
  padding: 0 18px;
}

.yours .added {
  background: var(--mark);
  color: var(--heading);
  font-weight: 600;
  box-shadow: inset 3px 0 0 var(--accent);
}

.shot {
  overflow: hidden;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  background: var(--surface);
}

.ours {
  max-width: 580px;
}

.note {
  margin: 14px 0 0;
  font-size: 0.92rem;
  color: var(--ink-muted);
}

/* Content blocks */
.block {
  padding: clamp(56px, 8vw, 104px) var(--gutter) 0;
}

.block h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.025em;
  line-height: 1.05;
  margin-bottom: 18px;
}

.intro {
  max-width: var(--measure);
  margin: 0 0 32px;
  color: var(--ink-muted);
}

.principles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 30ch), 1fr));
  gap: 28px 56px;
  max-width: 1180px;
  margin: 0;
}

.principles div {
  padding-top: 14px;
  border-top: 2px solid var(--line);
}

.principles dt {
  font: 700 1.15rem/1.3 var(--font-display);
  color: var(--heading);
  margin-bottom: 6px;
}

.principles dd {
  margin: 0;
  color: var(--ink-muted);
}

.principles dd :global(p) {
  margin: 0;
}

.sidebar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  gap: 8px;
  max-width: 1180px;
  padding: 10px;
  background: var(--surface-muted);
  border-radius: var(--radius);
}

.group h3 {
  padding: 10px 12px 6px;
  font: 600 0.78rem/1 var(--font-text);
  color: var(--ink-muted);
}

.group ul {
  margin: 0;
  padding: 0;
  list-style: none;
}

.group li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 12px;
  font-size: 0.95rem;
  color: var(--ink-muted);
}

.group li.released {
  color: var(--ink);
  font-weight: 600;
}

/* The ring of a planned page uses the muted ink, which keeps 3:1 against the grid in both themes (WCAG 1.4.11). */
.dot {
  flex: none;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1.5px var(--ink-muted);
}

.released .dot,
.dot.on {
  background: var(--accent-ink);
  box-shadow: none;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin: 14px 0 0;
  font-size: 0.88rem;
  color: var(--ink-muted);
}

.legend .dot:not(.on) {
  margin-left: 14px;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  gap: 32px;
  max-width: 1180px;
  margin-top: 40px;
}

.gallery figure {
  margin: 0;
}

.gallery figcaption {
  margin-top: 10px;
  font-weight: 600;
  color: var(--heading);
}

.cli {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  gap: 24px 56px;
  align-items: start;
  padding-bottom: clamp(120px, 14vw, 200px);
}

.cli pre {
  margin: 0;
  padding: 18px 20px;
  background: var(--code-bg);
  color: var(--code-ink);
  border-radius: var(--radius);
  line-height: 1.8;
}

/* Install, on the teal of the wave */
.install {
  margin-top: -2px;
  padding: 0 var(--gutter) 48px;
  background: var(--accent);
  color: var(--on-accent);
}

.install h2 {
  font-size: clamp(2.2rem, 4.6vw, 3.4rem);
  letter-spacing: -0.025em;
  color: var(--on-accent);
}

.install-intro,
.method {
  max-width: 920px;
}

.install :global(a) {
  text-decoration-color: currentColor;
}

.methods ul {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 8px;
  padding: 0;
  list-style: none;
}

.methods a {
  display: block;
  padding: 9px 16px;
  border-radius: 999px;
  background: rgb(255 255 255 / 0.35);
  font-weight: 600;
  font-size: 0.92rem;
  text-decoration: none;
}

.methods a:hover {
  background: rgb(255 255 255 / 0.55);
}

.more {
  max-width: 920px;
  margin: 24px 0 0;
}

.method {
  padding-top: 28px;
  scroll-margin-top: 16px;
}

.method h3 {
  font-size: 1.45rem;
  color: var(--on-accent);
  margin-bottom: 8px;
}

.method :global(pre) {
  padding: 16px 20px;
  background: var(--code-bg);
  color: var(--code-ink);
  border-radius: var(--radius);
  line-height: 1.75;
}

.method :global(.code) {
  position: relative;
}

.method :global(.code pre) {
  padding-right: 60px;
}

.method :global(.copy) {
  position: absolute;
  top: 8px;
  right: 8px;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  padding: 0;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--code-ink);
  cursor: pointer;
  transition: background-color 0.15s ease-out, color 0.15s ease-out;
}

.method :global(.copy:hover) {
  background: rgb(255 255 255 / 0.12);
}

.method :global(.copy.done) {
  color: var(--accent);
}

.method :global(.copy:focus-visible) {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.method :global(p code),
.method :global(li code),
.install-intro :global(code) {
  padding: 0.1em 0.35em;
  border-radius: 5px;
  background: rgb(255 255 255 / 0.35);
}

@media (max-width: 820px) {
  .split,
  .cli {
    grid-template-columns: minmax(0, 1fr);
  }

  .split {
    gap: 40px;
  }

  .rule {
    display: none;
  }

  .yours {
    justify-self: stretch;
  }
}
</style>
