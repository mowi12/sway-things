#
# Words the sway config parser treats specially, for libFuzzer's -dict.

# A new file in the fuzz input (see fuzz_targets/sway_config.rs).
"\x0a#=> "
"\x0a#=> config.d/a.conf\x0a"
"\x0a#=> config.d/b.conf\x0a"
"\x0a#=> /etc/sway/config\x0a"

# Lines and blocks.
"\x0a"
"\\\x0a"
"#"
" {"
"{"
"}"
"\x0a{\x0a"
"\x0a}\x0a"

# Commands with special handling.
"set "
"set $"
"include "
"include config.d/*.conf"
"include ~/.config/sway/config.d/*"
"input "
"output "
"seat "
"bar "
"mode "
"exec "
"bindsym "
"for_window "
"type:touchpad"

# Variables, quotes and escapes.
"$"
"$$"
"$a"
"$a$a"
"${HOME}"
"$HOME"
"$DIR"
"$TWO"
"$STAR"
"\""
"'"
"\\"
"\\x41"
"\\0"
"["
"]"

# What an include path can contain.
"~"
"~/"
"*"
"?"
"[!a]"
"[a-z]"
"/"
"../"
".."
"$("
"`"
"${HOME:-x}"
"\x00"
