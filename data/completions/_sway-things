'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_sway-things_commands" \
"*::: :->sway-things" \
&& ret=0
    case $state in
    (sway-things)
        words=($line[1] "${words[@]}")
