;;
(displays)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(workspaces)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mirror)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(clipboard)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(screenshot)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':area -- What to capture\: a region you select (or a window you click) with slurp, the focused window, the focused display or all displays:((region\:"A region you select, or a window you click"
window\:"The focused window"
