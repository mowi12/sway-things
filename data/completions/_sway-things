'new-display:Ask once whether a display plugged in to a combination set up on the Displays page shows the same picture or extends the desktop, and remember the answer\: run by kanshi when one display more than such a combination is connected' \
    )
    _describe -t commands 'sway-things help hook commands' commands "$@"
}
