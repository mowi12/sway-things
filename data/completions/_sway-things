#compdef sway-things

autoload -U is-at-least

_sway-things() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_sway-things_commands" \
"*::: :->sway-things" \
&& ret=0
    case $state in
    (sway-things)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:sway-things-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
'--device=[The input device or display\: an input device by its identifier as \`swaymsg -t get_inputs\` shows it, a display by its make, model and serial as \`swaymsg -t get_outputs\` shows them, or in a sway session by its name]:IDENTIFIER:_default' \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'--json[Print JSON for scripts]' \
'-h[Print help]' \
'--help[Print help]' \
'::key -- The setting, e.g. windows.gaps.inner:_default' \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
'--device=[The input device or display\: an input device by its identifier as \`swaymsg -t get_inputs\` shows it, a display by its make, model and serial as \`swaymsg -t get_outputs\` shows them, or in a sway session by its name]:IDENTIFIER:_default' \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'(--shared)--host[Store the value for this machine only, in settings.d/<hostname>.toml]' \
'--shared[Store the value in the shared settings.toml]' \
'--yes[Change a setting that can lock you out without asking to keep it]' \
'--overwrite[Replace generated files that were changed outside Sway Things]' \
'-h[Print help]' \
'--help[Print help]' \
':key -- The setting, e.g. windows.gaps.inner:_default' \
':value -- The new value\: true or false, a number, a choice, a color as #rrggbb, text, or a list as items separated by commas (us,de):_default' \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
'--device=[The input device or display\: an input device by its identifier as \`swaymsg -t get_inputs\` shows it, a display by its make, model and serial as \`swaymsg -t get_outputs\` shows them, or in a sway session by its name]:IDENTIFIER:_default' \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'--yes[Reset a setting that can lock you out without asking to keep it]' \
'--overwrite[Replace generated files that were changed outside Sway Things]' \
'-h[Print help]' \
'--help[Print help]' \
':key -- The setting, e.g. windows.gaps.inner:_default' \
&& ret=0
;;
(show-generated)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'::file -- Only this file:(10-input.conf 20-output.conf 30-appearance.conf 40-behavior.conf 80-hooks.conf 90-effects.conf)' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'--fix[Write the generated files that are missing or out of date. Never touches your own files]' \
'--overwrite[With --fix, also replace generated files that were changed outside Sway Things]' \
'--json[Print JSON for scripts]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
'::link -- A page, e.g. `keyboard`, or a setting, e.g. `input.keyboard.repeat_rate`:_default' \
&& ret=0
;;
(hook)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
":: :_sway-things__subcmd__hook_commands" \
"*::: :->hook" \
&& ret=0

    case $state in
    (hook)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:sway-things-hook-command-$line[1]:"
        case $line[1] in
            (gsettings)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(displays)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(workspaces)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(mirror)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(new-display)
_arguments "${_arguments_options[@]}" : \
'--color=[Controls when to use color]:WHEN:(auto always never)' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_sway-things__subcmd__hook__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:sway-things-hook-help-command-$line[1]:"
        case $line[1] in
            (gsettings)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(displays)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(workspaces)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mirror)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(new-display)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_sway-things__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:sway-things-help-command-$line[1]:"
        case $line[1] in
            (get)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(set)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reset)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show-generated)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(hook)
_arguments "${_arguments_options[@]}" : \
":: :_sway-things__subcmd__help__subcmd__hook_commands" \
"*::: :->hook" \
&& ret=0

    case $state in
    (hook)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:sway-things-help-hook-command-$line[1]:"
        case $line[1] in
            (gsettings)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(displays)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(workspaces)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(mirror)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(new-display)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_sway-things_commands] )) ||
_sway-things_commands() {
    local commands; commands=(
'get:Show the value in effect and where it comes from; without a key, every stored setting' \
'set:Change a setting\: live, in the settings files and in the generated sway config' \
'reset:Remove the stored value of a setting and apply its default' \
'show-generated:Print the generated sway config files as they would be written, without writing them' \
'doctor:Check why settings might not take effect\: the compositor, your sway config and its include line, the settings files, the generated files and the lines of your config that win' \
'open:Start the app, or bring its window up if it runs, at a page or a setting' \
'hook:Run a hook; the generated sway config runs these' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'sway-things commands' commands "$@"
}
